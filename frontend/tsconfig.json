{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM"],
    "jsx": "react-jsx",
    "jsxImportSource": "@compiled/react",
    "noEmit": true,
    "types": ["jest", "@testing-library/jest-dom", "node"]
  },
  "include": ["src", "**/*.test.ts", "**/*.test.tsx"],
  "exclude": [
    "node_modules",
    "build",
    ".parcel-cache",
  ]
}
