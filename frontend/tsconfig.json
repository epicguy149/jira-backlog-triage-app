{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "jsxImportSource": "@compiled/react",
    "noEmit": true,
    "types": ["jest", "node"],
    "typeRoots": [
      "node_modules/@types",
      "src/types"
    ],
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true
  },
  "include": ["src", "**/*.test.ts", "**/*.test.tsx"],
  "exclude": [
    "node_modules",
    "build",
    ".parcel-cache",
  ]
}
