{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM"],
    "jsx": "react-jsx",
    "jsxImportSource": "@compiled/react",
    "noEmit": true,
    "typeRoots": [
      "node_modules/@types",
      "src/types"
    ],
  },
  "include": ["src"],
  "exclude": [
    "node_modules",
    "build",
    ".parcel-cache",
  ]
}
