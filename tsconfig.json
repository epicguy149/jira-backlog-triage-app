{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "nodenext",
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "baseUrl": ".",
    "paths": {
      "@contracts/*": ["contracts/*"],
      "@src/*": ["src/*"]
    }
  },
  "include": ["src", "contracts"]
}