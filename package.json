{
  "name": "jira-backlog-action-custom-ui",
  "version": "1.0.15",
  "main": "index.js",
  "license": "MIT",
  "private": true,
  "devDependencies": {
    "@compiled/babel-plugin": "^0.38.1",
    "@types/node": "^24.10.0",
    "@typescript-eslint/eslint-plugin": "^8.46.3",
    "@typescript-eslint/parser": "^8.46.3",
    "eslint": "^8.57.1",
    "rimraf": "^6.1.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@forge/api": "^6.2.0",
    "@forge/kvs": "^1.2.0",
    "@forge/resolver": "1.7.0",
    "npm-run-all": "^4.1.5",
    "zod": "^3.25.76"
  },
  "scripts": {
    "reset": "rimraf ./node_modules && rimraf ./frontend/node_modules && rimraf ./package-lock.json && rimraf ./frontend/package-lock.json && rimraf ./frontend/build",
    "install_": "npm install && npm install --prefix frontend",
    "clean": "rimraf ./frontend/build",
    "build": "npm run clean && npm run build --prefix frontend",
    "deploy": "npm run build && forge deploy",
    "lint": "eslint --ext .js,.jsx,.ts,.tsx src"
  }
}
